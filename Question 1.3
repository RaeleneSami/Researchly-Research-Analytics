   "source": [
    "\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "from sklearn.model_selection import (\n",
    "    train_test_split,\n",
    "    StratifiedKFold,\n",
    "    cross_val_score\n",
    ")\n",
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.feature_extraction.text import TfidfVectorizer\n",
    "from sklearn.naive_bayes import MultinomialNB\n",
    "from sklearn.metrics import (\n",
    "    accuracy_score,\n",
    "    classification_report,\n",
    "    confusion_matrix,\n",
    "    ConfusionMatrixDisplay\n",
    ")\n",
    "\n",
    "df = pd.read_csv('cleaned_research_abstracts.csv')\n",
    "\n",
    "\n",
    "df = df.dropna(subset=['Cleaned_Abstract', 'Label'])\n",
    "\n",
    "X = df['Cleaned_Abstract']\n",
    "y = df['Label']\n",
    "\n",
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X,\n",
    "    y,\n",
    "    test_size=0.20,\n",
    "    random_state=42,\n",
    "    stratify=y\n",
    ")\n",
    "\n",
    "print(\"Training Records:\", len(X_train))\n",
    "print(\"Testing Records:\", len(X_test))\n",
    "\n",
    "# Pipeline prevents TF-IDF data leakage\n",
    "model = Pipeline([\n",
    "    ('tfidf', TfidfVectorizer(\n",
    "        max_features=5000,\n",
    "        ngram_range=(1, 2),\n",
    "        sublinear_tf=True\n",
    "    )),\n",
    "    ('classifier', MultinomialNB())\n",
    "])\n",
    "\n",
    "model.fit(X_train, y_train)\n",
    "\n",
    "y_train_pred = model.predict(X_train)\n",
    "y_test_pred = model.predict(X_test)\n",
    "\n",
    "train_accuracy = accuracy_score(y_train, y_train_pred)\n",
    "test_accuracy = accuracy_score(y_test, y_test_pred)\n",
    "\n",
    "print(\"\\nMODEL ACCURACY\")\n",
    "print(\"Training Accuracy: {:.2f}%\".format(\n",
    "    train_accuracy * 100\n",
    "))\n",
    "print(\"Testing Accuracy: {:.2f}%\".format(\n",
    "    test_accuracy * 100\n",
    "))\n",
    "\n",
    "print(\"Generalisation Gap: {:.2f}%\".format(\n",
    "    (train_accuracy - test_accuracy) * 100\n",
    "))\n",
    "\n",
    "print(\"\\nCLASSIFICATION REPORT\")\n",
    "print(classification_report(\n",
    "    y_test,\n",
    "    y_test_pred,\n",
    "    zero_division=0\n",
    "))\n",
    "\n",
    "cm = confusion_matrix(y_test, y_test_pred)\n",
    "\n",
    "disp = ConfusionMatrixDisplay(\n",
    "    confusion_matrix=cm,\n",
    "    display_labels=model.classes_\n",
    ")\n",
    "\n",
    "disp.plot(cmap='Blues', values_format='d')\n",
    "plt.title('Baseline Model - Confusion Matrix')\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "cv = StratifiedKFold(\n",
    "    n_splits=5,\n",
    "    shuffle=True,\n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "cv_scores = cross_val_score(\n",
    "    model,\n",
    "    X_train,\n",
    "    y_train,\n",
    "    cv=cv,\n",
    "    scoring='f1_macro'\n",
    ")\n",
    "\n",
    "print(\"\\nCROSS-VALIDATION RESULTS\")\n",
    "print(\"F1 Scores:\", cv_scores)\n",
    "print(\"Mean F1 Score: {:.2f}%\".format(\n",
    "    cv_scores.mean() * 100\n",
    "))\n",
    "\n",
    "plt.figure(figsize=(7, 5))\n",
    "\n",
    "plt.bar(\n",
    "    ['Training', 'Testing'],\n",
    "    [train_accuracy * 100, test_accuracy * 100]\n",
    ")\n",
    "\n",
    "plt.title('Training vs Testing Accuracy')\n",
    "plt.ylabel('Accuracy (%)')\n",
    "plt.ylim(0, 100)\n",
    "\n",
    "for i, value in enumerate(\n",
    "    [train_accuracy * 100, test_accuracy * 100]\n",
    "):\n",
    "    plt.text(\n",
    "        i, value + 1,\n",
    "        f'{value:.2f}%',\n",
    "        ha='center'\n",
    "    )\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(\"\\nBaseline Model Evaluation Completed Successfully!\")\n"
   ]
