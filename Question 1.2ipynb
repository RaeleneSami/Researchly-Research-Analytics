      "Dataset Shape: (1125, 4)\n",
      "Available Columns: ['DOI', 'Abstract', 'Label', 'Cleaned_Abstract']\n",
      "\n",
      "Research Category Distribution:\n",
      "Label\n",
      "classical    890\n",
      "ai           235\n",
      "Name: count, dtype: int64\n",
      "\n",
      "TF-IDF Feature Matrix Shape:\n",
      "(1125, 5000)\n",
      "\n",
