   "source": [
    "\n",
    "import pandas as pd\n",
    "import zipfile\n",
    "import os\n",
    "\n",
    "articles = []\n",
    "\n",
    "with zipfile.ZipFile(\"research_corpus.zip\", \"r\") as zip_ref:\n",
    "\n",
    "    for filename in sorted(zip_ref.namelist()):\n",
    "\n",
    "        if filename.lower().endswith(\".txt\"):\n",
    "\n",
    "            content = zip_ref.read(filename).decode(\n",
    "                \"utf-8\", errors=\"replace\"\n",
    "            )\n",
    "\n",
    "            articles.append({\n",
    "                \"Article\": os.path.basename(filename),\n",
    "                \"Content\": content,\n",
    "                \"Word_Count\": len(content.split())\n",
    "            })\n",
    "\n",
    "df_articles = pd.DataFrame(articles)\n",
    "\n",
    "print(\"Total Research Articles:\", len(df_articles))\n",
    "\n",
    "print(\"\\nResearch Articles:\")\n",
    "print(df_articles[[\"Article\", \"Word_Count\"]])\n",
    "\n",
    "print(\"\\nFirst Article Content:\")\n",
    "print(df_articles[\"Content\"].iloc[0][:1000])\n",
    "\n",
    "df_articles.to_csv(\n",
    "    \"research_articles_dataframe.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "print(\"\\nDataFrame Created Successfully!\")\n"
   ]
